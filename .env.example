# CC Election Portal - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ===========================================
# REQUIRED FOR PRODUCTION
# ===========================================

# Environment mode: 'development' or 'production'
# IMPORTANT: Set to 'production' for live deployments
NODE_ENV=production

# Admin authentication token
# Generate a secure random string (min 32 characters)
# Example: openssl rand -hex 32
ADMIN_TOKEN=your-secure-admin-token-here

# ===========================================
# OPTIONAL CONFIGURATION
# ===========================================

# Server port (default: 3000)
PORT=3000

# Audit repair key (for emergency audit chain recovery)
# Only needed if you need to repair a corrupted audit chain
# Generate: openssl rand -hex 32
AUDIT_REPAIR_KEY=

# CORS allowed origins (comma-separated)
# Leave empty for same-origin only (recommended for production)
# Example: https://elections.cardano.org,https://portal.intersectmbo.org
ALLOWED_ORIGINS=

# Edit token expiration in days (default: 90)
TOKEN_EXPIRY_DAYS=90
